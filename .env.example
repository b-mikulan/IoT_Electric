EWS_USER=your_username
EWS_PASSWORD=your_password

# Middleware access credentials. Generate them with: npm run auth:generate
MIDDLEWARE_USER=middleware-admin
MIDDLEWARE_PASSWORD_HASH=scrypt:replace_with_generated_salt:replace_with_generated_hash

# Optional overrides
# EWS_URL=https://bms.iot-electric.hr/EcoStruxure/DataExchange
# PORT=3000

# PLC widget dashboard (http://localhost:3001)
DASHBOARD_DEMO_MODE=true
DASHBOARD_POLL_INTERVAL_MS=15000
DASHBOARD_MIDDLEWARE_TIMEOUT_MS=10000

# For real PLC values, disable demo mode and configure the client password and points.
# DASHBOARD_DEMO_MODE=false
# DASHBOARD_MIDDLEWARE_PASSWORD=the_plaintext_password_generated_for_MIDDLEWARE_USER
# Alternatively mount a Docker/Portainer secret and set:
# DASHBOARD_MIDDLEWARE_PASSWORD_FILE=/run/secrets/middleware_password
# DASHBOARD_WIDGETS_JSON=[{"id":"01/ES/Building/Temperature","label":"Temperatura ureda","description":"Ured · prizemlje","unit":"°C","precision":1}]
