PORT=3001
POLL_INTERVAL_MS=15000
MIDDLEWARE_TIMEOUT_MS=10000

# Set your own dashboard credentials in .env.
# DASHBOARD_LOGIN_USER=operator
# DASHBOARD_LOGIN_PASSWORD=
# DASHBOARD_ADMIN_USER=admin
# DASHBOARD_ADMIN_PASSWORD=
# DASHBOARD_DB_FILE=./config/dashboard.sqlite
# DASHBOARD_USERS_FILE=./config/dashboard-users.json
# DASHBOARD_SECURE_COOKIES=true

# Keep this enabled for a preview with clearly marked demo data.
DEMO_MODE=true

# Real mode: the dashboard server calls the middleware; credentials never reach the browser.
# DEMO_MODE=false
# MIDDLEWARE_URL=http://127.0.0.1:3000
# MIDDLEWARE_USER=middleware-admin
# MIDDLEWARE_PASSWORD=replace_with_plaintext_middleware_password
# MIDDLEWARE_PASSWORD_FILE=/run/secrets/middleware_password
# WIDGETS_FILE=./config/widgets.json
# Optional legacy card settings to migrate on first start.
# DEVICE_WIDGETS_FILE=./config/device-widgets.json
# WIDGETS_JSON can seed the database instead of WIDGETS_FILE.
