PORT=3001
POLL_INTERVAL_MS=15000
MIDDLEWARE_TIMEOUT_MS=10000

# Keep this enabled for a zero-configuration preview with clearly marked demo data.
DEMO_MODE=true

# Real mode: the dashboard server calls the middleware; credentials never reach the browser.
# DEMO_MODE=false
# MIDDLEWARE_URL=http://127.0.0.1:3000
# MIDDLEWARE_USER=middleware-admin
# MIDDLEWARE_PASSWORD=replace_with_plaintext_middleware_password
# MIDDLEWARE_PASSWORD_FILE=/run/secrets/middleware_password
# WIDGETS_FILE=./config/widgets.json
# WIDGETS_JSON remains available as an inline override when a file cannot be mounted.
