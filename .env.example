EWS_USER=your_username
EWS_PASSWORD=your_password

# Middleware access credentials. Generate them with: npm run auth:generate
MIDDLEWARE_USER=middleware-admin
MIDDLEWARE_PASSWORD_HASH=scrypt:replace_with_generated_salt:replace_with_generated_hash

# Optional overrides
# EWS_URL=https://bms.iot-electric.hr/EcoStruxure/DataExchange
# Total budget for one container read, including all pages. Keep below the dashboard timeout.
# EWS_CONTAINER_TIMEOUT_MS=8000
# PORT=3000

# PLC widget dashboard (http://localhost:3001)
# Set your own dashboard credentials in .env or in the Portainer stack.
# DASHBOARD_LOGIN_USER=operator
# DASHBOARD_LOGIN_PASSWORD=
# DASHBOARD_ADMIN_USER=admin
# DASHBOARD_ADMIN_PASSWORD=
# The database lives on the mounted dashboard configuration volume.
# DASHBOARD_DB_FILE=/app/config/dashboard.sqlite
# Optional legacy users file to read on the first database start.
# DASHBOARD_USERS_FILE=/app/config/dashboard-users.json
# Enable when the browser reaches the dashboard over HTTPS.
# DASHBOARD_SECURE_COOKIES=true
DASHBOARD_DEMO_MODE=true
DASHBOARD_POLL_INTERVAL_MS=15000
DASHBOARD_MIDDLEWARE_TIMEOUT_MS=10000
# Large buildings can use smaller, sequential batches with an idle pause.
# DASHBOARD_READ_BATCH_SIZE=128
# DASHBOARD_READ_BATCH_DELAY_MS=1000

# For real PLC values, disable demo mode and configure the client password and points.
# DASHBOARD_DEMO_MODE=false
# DASHBOARD_MIDDLEWARE_PASSWORD=the_plaintext_password_generated_for_MIDDLEWARE_USER
# Alternatively mount a Docker/Portainer secret and set:
# DASHBOARD_MIDDLEWARE_PASSWORD_FILE=/run/secrets/middleware_password

# Optional legacy widgets file to read on the first database start.
# DASHBOARD_WIDGETS_FILE=/app/config/widgets.json
# Legacy device settings default to device-widgets.json beside WIDGETS_FILE.
# DASHBOARD_DEVICE_WIDGETS_FILE=/app/config/device-widgets.json
# Catalog descriptions are auto-detected as catalog-metadata.json beside WIDGETS_FILE.
# DASHBOARD_DEVICE_METADATA_FILE=/app/config/catalog-metadata.json
# Portainer can set DASHBOARD_CONFIG_SOURCE to a host directory containing that file.
# DASHBOARD_WIDGETS_JSON can seed the database instead of DASHBOARD_WIDGETS_FILE.

# Multiple Portainer stacks on one Docker host need different published ports.
# Internal container ports remain 3000 and 3001.
# MIDDLEWARE_HOST_PORT=3100
# DASHBOARD_HOST_PORT=3101
# Prepare instance folders, widget permissions and credentials with:
# sudo bash tools/stack-setup/prepare-instance.sh --name cnus --image-tag 0.5.0
